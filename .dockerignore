# File yang TIDAK ikut dikirim ke Docker saat build.

# Secret tidak boleh masuk image. Siapa pun yang memegang image dapat
# membaca seluruh isinya, termasuk file yang "tersembunyi".
.env
.env.*

# Hasil kerja lokal yang tidak dibutuhkan untuk build.
.git
logs/
*.log
coverage.out

# CATATAN (tambahan saya): folder UTS adalah project terpisah (go.mod
# sendiri), bukti/ berisi screenshot laporan, dan PDF modul/laporan tidak
# dibutuhkan untuk compile. Semuanya tidak perlu ikut dikirim ke Docker.
UTS/
bukti/
*.pdf
